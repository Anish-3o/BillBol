# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/billbol
CLIENT_URL=http://localhost:5173

# Week 1 - auth. Required: the API refuses to start without them.
# Use two different values of at least 32 characters. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AI features (voice billing). An Anthropic API key from https://platform.claude.com.
# Optional: without it the app works, and voice billing says it is not set up.
# Use a real key only in .env, never in code or commits.
LLM_API_KEY=
