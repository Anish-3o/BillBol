{
  // Vercel compiles api/index.ts (and the server files it imports) with the first tsconfig it
  // finds walking up from api/, so server/tsconfig.json is never seen. Without these settings,
  // esModuleInterop is off and `import express from 'express'` crashes at startup with
  // "express_1.default is not a function". These mirror server/tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // The root has no node_modules of its own; the server's install has @types/node.
    "typeRoots": ["../server/node_modules/@types"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["."]
}
